MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100370961}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c13a73081732fd043acd7d0d632b931a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  missionID: 0
  missionSystem: {fileID: 1584171156}
  dialogueAudio: {fileID: 8300000, guid: 0351b542558ed3345864afd5536107b7, type: 3}
  subtitles:
  - text: "\u2014I\u2019m so glad you came."
    startTime: 0
    endTime: 3
  - text: "\u2014 You\u2019ve lost so much weight."
    startTime: 3
    endTime: 5
  - text: "\u2014 I\u2019m glad to see you too. How are things here?"
    startTime: 5
    endTime: 9
  - text: "\u2014 Oh, everything\u2019s the same as always. "
    startTime: 9
    endTime: 11
  - text: "\u2014 Only those damn neighbors from apartment 9 keep us from sleeping. "
    startTime: 11
    endTime: 15
  - text: "\u2014 Last Friday Svetka pulled another stunt\u2026"
    startTime: 16
    endTime: 19
  - text: "\u2014 Listen, Grandma, I should probably get going. It\u2019s already
      very dark and I need to catch the bus."
    startTime: 20
    endTime: 27
  - text: "\u2014 Yes, yes, yes. Just take some sunflower seeds with you. They\u2019re
      very tasty."
    startTime: 27
    endTime: 32
  - text: "\u2014 Thank you very much. All the best."
    startTime: 33
    endTime: 36
  subtitleText: {fileID: 1819036172}
