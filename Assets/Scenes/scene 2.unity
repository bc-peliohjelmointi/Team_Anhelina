MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 674179711}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b698f3e6a373a2945a2e6dc5173e605b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlayerMonologue
  clip: {fileID: 8300000, guid: 38ae64ea14a950346be7fb1a4db0b9c9, type: 3}
  lines:
  - text: "\u2014 It\u2019s already so dark, and I still have to stop by Grandma
      Tamara\u2019s place for a visit."
    startTime: 0
    endTime: 5
  - text: "\u2014 It\u2019s strange\u2026 "
    startTime: 6
    endTime: 7
  - text: "\u2014 the streetlights are glowing along the road I\u2019m supposed to
      take. "
    startTime: 8
    endTime: 12
  - text: "\u2014 Something tells me I\u2019d better not walk there in the dark."
    startTime: 13
    endTime: 17
  subtitleText: {fileID: 1819036172}
  fadeSpeed: 3
