  m_Script: {fileID: 11500000, guid: c13a73081732fd043acd7d0d632b931a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  missionID: 1
  missionSystem: {fileID: 1584171156}
  dialogueAudio: {fileID: 8300000, guid: b586cafa7133f2848a3961edf417e099, type: 3}
  subtitles:
  - text: "\u2014 Hey! What's up? How's it going?"
    startTime: 0
    endTime: 2
  - text: "\u2014 I don't know, guys. How are things with you?"
    startTime: 3
    endTime: 6
  - text: "\u2014 We're keeping it quiet here, holding down the district. Guarding
      it\u2026"
    startTime: 7
    endTime: 10
  - text: "\u2014 What a weird evening. I feel like I'm not in reality\u2026"
    startTime: 11
    endTime: 15
  - text: "\u2014 Hey, listen up\u2026 Do you have some kind of problem?"
    startTime: 16
    endTime: 19
  - text: "\u2014 Nah, no, no. It's all good, boys."
    startTime: 20
    endTime: 23
  - text: "\u2014 Ooh, fuckin' thank you!"
    startTime: 25
    endTime: 27
  subtitleText: {fileID: 1819036172}
  fadeSpeed: 3
