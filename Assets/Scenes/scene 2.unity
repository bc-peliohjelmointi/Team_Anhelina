  subtitleLines:
  - startTime: 0
    endTime: 3.5
    text: It's already so dark,
  - startTime: 3.5
    endTime: 7.5
    text: 'and I still have to stop by

      Grandma Tamara''s place for a visit.'
  - startTime: 7.5
    endTime: 12
    text: 'It''s strange how the streetlights

      are shining along the road I
      need to take.'
  - startTime: 12
    endTime: 17
    text: "Something tells me it might be better\nnot to walk in the dark\u2026"
  playerMovementScript: {fileID: 1986571417}
  playerLookScript: {fileID: 1961362329}
